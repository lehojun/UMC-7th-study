3.홈 화면 쿼리 (현재 선택 된 지역에서 도전이 가능한 미션 목록, 페이징 포함)
public class MissionRepositoryImpl implements MissionCustomRepository {

private final JPAQueryFactory jpaQueryFactory;


//미션 개수 조회하는 쿼리
@Override
public optional<member_mission> myMissionCount(int memberId) {

return jpaQueryFactory
				.selectFrom(member_mission.count())
				.where(member_mission.memberId.eq(memberId) and 
								member_mission.status.eq("ed"))
				.fetch();
}

//my mission 조회 커리
@Override
public List<member_mission> myMissionList(int memberId) {

List<member_mission> result = queryFactory
						.select(member_mission)
						.from(member_mission)
						.where(member_mission.status.eq("ing"))
						.fetch();
						}
}

